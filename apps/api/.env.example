PORT=3100
MONGO_URI=mongodb://127.0.0.1:27017/motionily
# Or no MongoDB at all: one SQLite file (takes precedence over MONGO_URI).
# DATABASE_URL=sqlite:/absolute/path/motionily.db
# Agent CLI that runs in-app generation: claude (default), codex, gemini or opencode.
# MOTIONILY_AGENT=claude
# For CLIs other than Claude Code, Motionily's model tiers mapped to that CLI's model ids.
# MOTIONILY_AGENT_MODELS={"opus":"openai/gpt-5.5","sonnet":"openai/gpt-5.5-mini","*":"openai/gpt-5.5"}
JWT_SECRET=change-me
WEB_ORIGIN=http://localhost:5173
# Encrypts users' third-party keys (ElevenLabs) at rest; defaults to JWT_SECRET.
SECRETS_KEY=change-me-too
# Free stock sources the agent searches when the user has no key of their own (optional).
PEXELS_API_KEY=
PIXABAY_API_KEY=
EUROPEANA_API_KEY=
# Background removal model (BiRefNet lite, MIT); downloaded once on first use.
# MODELS_DIR=/var/lib/motionily/models
