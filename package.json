{
  "name": "motionily",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "wasm": "bash scripts/build-wasm.sh",
    "dev": "pnpm wasm && pnpm --filter @motionily/web dev",
    "mcp": "pnpm --filter @motionily/mcp-server start",
    "build": "pnpm wasm && pnpm -r build",
    "test": "cargo test --workspace --exclude engine-wasm --exclude motionily-desktop && cargo check -p engine-wasm --target wasm32-unknown-unknown && pnpm -r typecheck && pnpm --filter @motionily/api test",
    "desktop": "pnpm --filter @motionily/api build && pnpm --filter @motionily/desktop dev",
    "api": "pnpm --filter @motionily/api build && pnpm --filter @motionily/api start"
  }
}
